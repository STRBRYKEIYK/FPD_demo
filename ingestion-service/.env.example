# -- Server ---------------------------------------------------------------
PORT=4100
ALLOWED_ORIGIN=http://localhost:5175,http://localhost:5173

# -- Python OCR worker (EasyOCR fallback) --------------------------------
OCR_PYTHON_BIN=python
OCR_PYTHON_TIMEOUT_MS=45000
OCR_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# OCR_PYTHON_SCRIPT=C:/path/to/ingestion-service/python/ocr_worker.py

# -- Qwen-VL OCR via OpenRouter (primary) --------------------------------
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
QWEN_MODEL=qwen/qwen2.5-vl-72b-instruct
# QWEN_OCR_TIMEOUT_MS=30000
# QWEN_OCR_PROMPT=Extract all visible text from this image exactly as it appears.
